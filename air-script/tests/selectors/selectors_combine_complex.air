def SelectorsAir

const R = [8, 4, 20, 31, 5, 15];

trace_columns {
    main: [s[3], c],
}

buses {
    multiset p,
}

public_inputs {
    stack_inputs: [1],
}

boundary_constraints {
    enf c.first = 0;
    enf p.first = null;
    enf p.last = null;
}

fn double_with_mult(a: felt) -> felt {
    return 2*a;
}

fn double_with_add(a: felt) -> felt {
    return a+a;
}

# Note: we want the following values to be equal:
# a = c = f
# g = h

ev ev_s0([c]) {
    p.insert(1, 2) when c;
    enf c = double_with_mult(R[0]); #a
    enf c = R[1]; #b
    enf c = double_with_add(R[0]); #c
    enf c = R[2]; #d
}

ev ev_s1([c]) {
    enf c = R[3]; #e
    enf c = 16; #f
    enf c = R[4]; #g
}

ev ev_s2([c]) {
    enf c = R[4]; #h
    enf c = R[5]; #i
}

integrity_constraints {
    let s0 = s[0];
    let s1 = !s[0] & s[1];
    let s2 = !s[0] & !s[1];

    enf match {
        case s0: ev_s0([c]),
        case s1: ev_s1([c]),
        case s2: ev_s2([c]),
    };
}