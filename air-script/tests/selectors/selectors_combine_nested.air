def SelectorsAir

const R = [8, 4, 20, 31, 5, 15];

trace_columns {
    main: [s[3], a, b, c],
}

public_inputs {
    stack_inputs: [1],
}

boundary_constraints {
    enf c.first = 0;
}

# Simple evaluator functions
ev ev_dummy_0([b]) {
    enf b' = b + 1;
}

ev ev_dummy_1([b]) {
    enf b' = b;
}

ev ev_s0([a, b, c]) {
    enf c = R[2];
}  

ev ev_s2([a, b, c]) {
    enf b = R[4];
}

# Evaluator with nested match statement
ev ev_s1([a, b, c]) {
    enf a * (a - 1) = 0;
    enf b = 31;
    enf c = 5;

    # This creates Vector nodes with Enf operations
    enf match {
        case a: ev_dummy_0([b]),
        case !a: ev_dummy_1([b]),
    };
}

# Main constraint with nested evaluator calls
integrity_constraints {
    let s0 = s[0];
    let s1 = !s[0] & s[1];
    let s2 = !s[0] & !s[1];

    # This pattern creates the problematic Vector structures
    enf match {
        case s0: ev_s0([a, b, c]),
        case s1: ev_s1([a, b, c]),    # ← This call creates nested Vector->Enf structures
        case s2: ev_s2([a, b, c]),
    };
}