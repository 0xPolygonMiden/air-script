##########################################################################################
# HASHER CHIPLET CONSTRAINTS MODULE
##########################################################################################
#
# The hasher module is responsible for all hash-related operations, which include:
#
# 1. A single permutation of Poseidon2.
# 2. A simple 2-to-1 hash.
# 3. A linear hash of n field elements.
# 4. Merkle path verification.
# 5. Merkle root update.
#
# References:
# - Hasher chiplet design: https://0xmiden.github.io/miden-vm/design/chiplets/hasher.html
##########################################################################################

mod hasher

use utils::*;

##########################################################################################
# HASHER CHIPLET TRANSITION CONSTRAINTS
##########################################################################################

# Enforces the constraints on the hasher chiplet given its columns.
#
# The hasher chiplet executes a 32-row Poseidon2 cycle, with internal selectors indicating
# which hasher operation is in progress. The selector rows and flags are interpreted as:
#
# - f_abp: absorb for linear hash (capacity is preserved).
# - f_mpa/f_mva/f_mua: Merkle absorb variants (capacity reset, digest placed in correct rate lanes).
# - f_out: operation finished (i must be zero at the end of the cycle).
#
# The constraints below are grouped logically:
#
# - permutation (Poseidon2)
# - selector semantics
# - boundary constraints (capacity preservation, output row requires node index i = 0)
# - Merkle index updates
# - Merkle absorb behavior
#
ev hash_chiplet([chiplet_s0, s[3], h[12], i, system_clk]) {
    # Hasher rows are selected when the chiplet selector s0 = 0.
    let hash_active = 1 - chiplet_s0;

    # -------------------------------------------------------------------------
    # Poseidon2 permutation
    # -------------------------------------------------------------------------
    # Poseidon2 permutation constraints (rows 0..30 of the 32-row cycle).
    enf poseidon2_permutation([chiplet_s0, h]);

    # -------------------------------------------------------------------------
    # Selector constraints
    # -------------------------------------------------------------------------
    # Selector bits are binary.
    let selector_bits = [s[0], s[1], s[2]];
    enf binary_constraint(bit) = 0 for bit in selector_bits when hash_active;

    # Flags derived from selector values and cycle markers.
    let f_bp = get_f_bp(s, cycle_row_0);
    let f_abp = get_f_abp(s, cycle_row_31);
    let f_mpa = get_f_mpa(s, cycle_row_31);
    let f_mva = get_f_mva(s, cycle_row_31);
    let f_mua = get_f_mua(s, cycle_row_31);
    let f_hout = get_f_hout(s, cycle_row_31);
    let f_sout = get_f_sout(s, cycle_row_31);
    let f_out = get_f_out(s, cycle_row_31);
    let f_out_next = get_f_out_next(s, cycle_row_30, s[0]', s[1]');
    let f_absorb = f_mpa + f_mva + f_mua;

    # Selector bits s1/s2 are stable except at cycle boundaries (f_out or f_out_next).
    let stability_gate = 1 - f_out - f_out_next;
    let stable_next = [s[1]', s[2]'];
    let stable_cur = [s[1], s[2]];
    enf next = cur for (next, cur) in (stable_next, stable_cur) when hash_active * stability_gate;

    # Any absorb op forces s0' = 0 at the start of the next cycle.
    let f_continue = f_abp + f_absorb;
    enf s[0]' = 0 when hash_active * f_continue;

    # On output rows, (s0=0, s1=1, *) is invalid.
    enf (1 - s[0]) * s[1] = 0 when hash_active * cycle_row_31;

    # -------------------------------------------------------------------------
    # Cycle boundary constraints
    # -------------------------------------------------------------------------
    # ABP keeps capacity lanes unchanged.
    let cap_next = [h[8]', h[9]', h[10]', h[11]'];
    let cap_cur = [h[8], h[9], h[10], h[11]];
    enf next = cur for (next, cur) in (cap_next, cap_cur) when hash_active * f_abp;

    # Output row must end with i = 0.
    enf i = 0 when hash_active * f_out;

    # -------------------------------------------------------------------------
    # Merkle index constraints
    # -------------------------------------------------------------------------
    let f_mp = get_f_mp(s, cycle_row_0);
    let f_mv = get_f_mv(s, cycle_row_0);
    let f_mu = get_f_mu(s, cycle_row_0);

    # Index shifts occur when absorbing a new node (path/verify/update variants).
    let f_shift = f_mp + f_mv + f_mu + f_absorb;
    # b is the dropped bit in i' = floor(i/2), i.e., i = 2*i' + b.
    let b = i - 2 * i';

    # b is the dropped bit in the right shift; it must be binary when shifting.
    enf (b^2 - b) = 0 when hash_active * f_shift;

    # Otherwise, i is stable across rows.
    let not_absorbing_nor_comp_finished = 1 - (f_shift + f_out);
    enf i' = i when hash_active * not_absorbing_nor_comp_finished;

    # -------------------------------------------------------------------------
    # Merkle absorb constraints
    # -------------------------------------------------------------------------
    # Digest placement: b=0 -> rate0, b=1 -> rate1.
    let f_b0 = f_absorb * (1 - b);
    let f_b1 = f_absorb * b;

    # Absorb resets capacity lanes to 0.
    enf cap = 0 for cap in cap_next when hash_active * f_absorb;

    let rate0_next = [h[0]', h[1]', h[2]', h[3]'];
    let rate0_cur = [h[0], h[1], h[2], h[3]];
    enf next = cur for (next, cur) in (rate0_next, rate0_cur) when hash_active * f_b0;

    let rate1_next = [h[4]', h[5]', h[6]', h[7]'];
    # When b=1, place the digest (from rate0) into rate1.
    enf next = cur for (next, cur) in (rate1_next, rate0_cur) when hash_active * f_b1;

    ####################################################################################
    # HASH-KERNEL BUS OPERATIONS (MERKLE SIBLING TABLE)
    ####################################################################################
    # These messages populate the hash-kernel virtual table with Merkle sibling entries.
    # The layout is fixed by the bus spec; unused slots are set to 0.
    #
    # Walkthrough:
    # - MV/MVA insert siblings (old path), MU/MUA remove siblings (new path).
    # - b=0 uses the right sibling h4..h7, b=1 uses the left sibling h0..h3.
    # - node index i occupies the index field; all other unused fields are zero.
    let is_b_zero = 1 - b;
    let is_b_one = b;

    let h0 = h[0];
    let h1 = h[1];
    let h2 = h[2];
    let h3 = h[3];
    let h4 = h[4];
    let h5 = h[5];
    let h6 = h[6];
    let h7 = h[7];
    let h8 = h[8];
    let h9 = h[9];
    let h10 = h[10];
    let h11 = h[11];

    let h0_next = h[0]';
    let h1_next = h[1]';
    let h2_next = h[2]';
    let h3_next = h[3]';
    let h4_next = h[4]';
    let h5_next = h[5]';
    let h6_next = h[6]';
    let h7_next = h[7]';

    ####################################################################################
    # CHIPLETS BUS RESPONSES
    ####################################################################################
    # The hasher bus header uses clk + 1 as the row address (system clk starts at 0).
    let clk_plus_one = system_clk + 1;

    bus_6_chiplets_bus.insert(
        HASHERLINEARHASH + 16,
        clk_plus_one,
        i,
        h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11
    ) when (hash_active * f_bp);

    bus_6_chiplets_bus.insert(
        HASHERLINEARHASH + 32,
        clk_plus_one,
        i,
        0, 0, 0, 0, h0_next, h1_next, h2_next, h3_next, h4_next, h5_next, h6_next, h7_next
    ) when (hash_active * f_abp);

    bus_6_chiplets_bus.insert(
        HASHERRETURNHASH + 32,
        clk_plus_one,
        i,
        0, 0, 0, 0, h0, h1, h2, h3, 0, 0, 0, 0
    ) when (hash_active * f_hout);

    bus_6_chiplets_bus.insert(
        HASHERRETURNSTATE + 32,
        clk_plus_one,
        i,
        h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11
    ) when (hash_active * f_sout);

    bus_6_chiplets_bus.insert(
        HASHERMPVERIFY + 16,
        clk_plus_one,
        i,
        0, 0, 0, 0, h0, h1, h2, h3, 0, 0, 0, 0
    ) when (hash_active * f_mp * is_b_zero);
    bus_6_chiplets_bus.insert(
        HASHERMPVERIFY + 16,
        clk_plus_one,
        i,
        0, 0, 0, 0, h4, h5, h6, h7, 0, 0, 0, 0
    ) when (hash_active * f_mp * is_b_one);

    bus_6_chiplets_bus.insert(
        HASHERMRUPDATEOLD + 16,
        clk_plus_one,
        i,
        0, 0, 0, 0, h0, h1, h2, h3, 0, 0, 0, 0
    ) when (hash_active * f_mv * is_b_zero);
    bus_6_chiplets_bus.insert(
        HASHERMRUPDATEOLD + 16,
        clk_plus_one,
        i,
        0, 0, 0, 0, h4, h5, h6, h7, 0, 0, 0, 0
    ) when (hash_active * f_mv * is_b_one);

    bus_6_chiplets_bus.insert(
        HASHERMRUPDATENEW + 16,
        clk_plus_one,
        i,
        0, 0, 0, 0, h0, h1, h2, h3, 0, 0, 0, 0
    ) when (hash_active * f_mu * is_b_zero);
    bus_6_chiplets_bus.insert(
        HASHERMRUPDATENEW + 16,
        clk_plus_one,
        i,
        0, 0, 0, 0, h4, h5, h6, h7, 0, 0, 0, 0
    ) when (hash_active * f_mu * is_b_one);

    ####################################################################################
    # HASH-KERNEL BUS OPERATIONS (MERKLE SIBLING TABLE)
    ####################################################################################
    # These messages populate the hash-kernel virtual table with Merkle sibling entries.
    # The layout is fixed by the bus spec; unused slots are set to 0.
    #
    # Walkthrough:
    # - MV/MVA insert siblings (old path), MU/MUA remove siblings (new path).
    # - b=0 uses the right sibling h4..h7, b=1 uses the left sibling h0..h3.
    # - node index i occupies the index field; all other unused fields are zero.
    bus_5_v_table.insert(
        0, 0, i, 0, 0, 0, 0, h4, h5, h6, h7
    ) when (hash_active * f_mv * is_b_zero);
    bus_5_v_table.insert(
        0, 0, i, h0, h1, h2, h3, 0, 0, 0, 0
    ) when (hash_active * f_mv * is_b_one);
    bus_5_v_table.insert(
        0, 0, i, 0, 0, 0, 0, h4_next, h5_next, h6_next, h7_next
    ) when (hash_active * f_mva * is_b_zero);
    bus_5_v_table.insert(
        0, 0, i, h0_next, h1_next, h2_next, h3_next, 0, 0, 0, 0
    ) when (hash_active * f_mva * is_b_one);

    bus_5_v_table.remove(
        0, 0, i, 0, 0, 0, 0, h4, h5, h6, h7
    ) when (hash_active * f_mu * is_b_zero);
    bus_5_v_table.remove(
        0, 0, i, h0, h1, h2, h3, 0, 0, 0, 0
    ) when (hash_active * f_mu * is_b_one);
    bus_5_v_table.remove(
        0, 0, i, 0, 0, 0, 0, h4_next, h5_next, h6_next, h7_next
    ) when (hash_active * f_mua * is_b_zero);
    bus_5_v_table.remove(
        0, 0, i, h0_next, h1_next, h2_next, h3_next, 0, 0, 0, 0
    ) when (hash_active * f_mua * is_b_one);
}


##########################################################################################
# POSEIDON2 PERMUTATION EVALUATOR
##########################################################################################

# Poseidon2 permutation constraints for the hasher state.
#
# This evaluator is used from `hash_chiplet` to keep the main constraint block readable.
#
# Rows in the 32-row cycle:
# - Row 0: initial external linear layer (M_E).
# - Rows 1-4 and 27-30: external rounds (S-box on all lanes + M_E).
# - Rows 5-26: internal rounds (S-box on lane 0 + M_I).
# - Row 31: no permutation constraint (used for selector/control ops).
ev poseidon2_permutation([chiplet_s0, h[12]]) {
    let hash_active = 1 - chiplet_s0;

    let h_state = [h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7], h[8], h[9], h[10], h[11]];
    let h_state_next = [h[0]', h[1]', h[2]', h[3]', h[4]', h[5]', h[6]', h[7]', h[8]', h[9]', h[10]', h[11]'];

    # Init linear step: h' = M_E(h)
    let init_state = poseidon2_init_state(h_state);
    enf h_next = init_val for (h_next, init_val) in (h_state_next, init_state)
        when hash_active * cycle_row_0;

    # External rounds: h' = M_E(S-box(h + ark_ext))
    let ext_state = poseidon2_external_state(h_state);
    enf h_next = ext_val for (h_next, ext_val) in (h_state_next, ext_state)
        when hash_active * p2_is_external;

    # Internal rounds: h' = M_I(h with lane0 = (h0 + ark_int)^7)
    let int_state = poseidon2_internal_state(h_state);
    enf h_next = int_val for (h_next, int_val) in (h_state_next, int_state)
        when hash_active * p2_is_internal;
}

##########################################################################################
# HELPER FUNCTIONS
##########################################################################################

##########################################################################################
# INSTRUCTION FLAGS - DETAILED DESCRIPTIONS
##########################################################################################
#
# The hasher chiplet uses selector columns s[0], s[1], s[2] to encode different operations:
#
# INITIALIZATION FLAGS (on row 0 of a 32-row cycle):
# • f_bp:  (1,0,0) - Begin Permutation
#          Initiates: single permutation, 2-to-1 hash, or linear hash computation
# • f_mp:  (1,0,1) - Merkle Path verification
#          Starts standard Merkle path verification computation
# • f_mv:  (1,1,0) - Merkle path Verification for "old" node
#          Begins verification for old leaf value during Merkle root update
# • f_mu:  (1,1,1) - Merkle path verification for "new" node
#          Starts verification for new leaf value during Merkle root update
#
# ABSORPTION FLAGS (on row 31 of a 32-row cycle):
# • f_abp: (1,0,0) - Absorb elements for linear hash (continuing computation)
#          Absorbs next set of elements into hasher state during linear hash
# • f_mpa: (1,0,1) - Merkle Path Absorb during standard verification
#          Absorbs next Merkle path node during standard verification
# • f_mva: (1,1,0) - Merkle path absorb for "old" node verification
#          Absorbs next node during "old" leaf verification (Merkle root update)
# • f_mua: (1,1,1) - Merkle path absorb for "new" node verification
#          Absorbs next node during "new" leaf verification (Merkle root update)
#
# OUTPUT FLAGS (on row 31 of a 32-row cycle):
# • f_hout: (0,0,0) - Hash Output
#           Returns the result of the currently running hash computation
# • f_sout: (0,0,1) - State Output
#           Returns the entire 12-element hasher state
# • f_out:  Combined flag (f_hout | f_sout) - any output operation
#
##########################################################################################

# f_bp: Begin Permutation flag (1,0,0) on cycle_row_0
# Initiates single permutation, 2-to-1 hash, or linear hash computation.
fn get_f_bp(s: felt[3], row0: felt) -> felt {
    return row0 & s[0] & !s[1] & !s[2];
}

# f_mp: Merkle Path verification flag (1,0,1) on cycle_row_0
# Initiates standard Merkle path verification computation.
fn get_f_mp(s: felt[3], row0: felt) -> felt {
    return row0 & s[0] & !s[1] & s[2];
}

# f_mv: Merkle path Verification for "old" node flag (1,1,0) on cycle_row_0
# Begins verification for old leaf value during Merkle root update computation.
fn get_f_mv(s: felt[3], row0: felt) -> felt {
    return row0 & s[0] & s[1] & !s[2];
}

# f_mu: Merkle path verification for "new" node flag (1,1,1) on cycle_row_0
# Starts verification for new leaf value during Merkle root update computation.
fn get_f_mu(s: felt[3], row0: felt) -> felt {
    return row0 & s[0] & s[1] & s[2];
}

# f_abp: Absorb elements for linear hash flag (1,0,0) on cycle_row_31
# Absorbs next set of elements into hasher state during linear hash computation.
fn get_f_abp(s: felt[3], row31: felt) -> felt {
    return row31 & s[0] & !s[1] & !s[2];
}

# f_mpa: Merkle Path Absorb flag (1,0,1) on cycle_row_31
# Absorbs next Merkle path node during standard verification computation.
fn get_f_mpa(s: felt[3], row31: felt) -> felt {
    return row31 & s[0] & !s[1] & s[2];
}

# f_mva: Merkle path absorb for "old" node flag (1,1,0) on cycle_row_31
# Absorbs next node during "old" leaf verification (Merkle root update computation).
fn get_f_mva(s: felt[3], row31: felt) -> felt {
    return row31 & s[0] & s[1] & !s[2];
}

# f_mua: Merkle path absorb for "new" node flag (1,1,1) on cycle_row_31
# Absorbs next node during "new" leaf verification (Merkle root update computation).
fn get_f_mua(s: felt[3], row31: felt) -> felt {
    return row31 & s[0] & s[1] & s[2];
}

# Flag f_out is set to 1 when either f_hout = 1 or f_sout = 1 in the current row.
fn get_f_out(s: felt[3], row31: felt) -> felt {
    return row31 & !s[0] & !s[1];
}

# Flag f_out_next is set to 1 when either f_hout = 1 or f_sout = 1 in the next row.
fn get_f_out_next(s: felt[3], row30: felt, s0_next: felt, s1_next: felt) -> felt {
    return row30 & !s0_next & !s1_next;
}

# f_hout: Hash Output flag (0,0,0) on cycle_row_31
# Returns the 4-element hash result (h0-h3)
fn get_f_hout(s: felt[3], row31: felt) -> felt {
    return row31 & !s[0] & !s[1] & !s[2];
}

# f_sout: State Output flag (0,0,1) on cycle_row_31
# Returns the entire 12-element hasher state
fn get_f_sout(s: felt[3], row31: felt) -> felt {
    return row31 & !s[0] & !s[1] & s[2];
}

##########################################################################################
# LINEAR ALGEBRA HELPERS (POSEIDON2)
##########################################################################################

fn pow7(x: felt) -> felt {
    let x2 = x * x;
    let x4 = x2 * x2;
    return x4 * x2 * x;
}

# Multiplies a 4-element vector by the Poseidon2 4x4 MDS matrix M4.
# This is the core building block of the external linear layer: the full 12x12
# matrix is applied as three independent M4 multiplications on 4-element chunks,
# followed by a cross-chunk sum (see poseidon2_init_state / poseidon2_external_state).
fn matmul_m4(input: felt[4]) -> felt[4] {
    let a = input[0];
    let b = input[1];
    let c = input[2];
    let d = input[3];

    let t0 = a + b;
    let t1 = c + d;
    let t2 = 2 * b + t1;
    let t3 = 2 * d + t0;
    let t4 = 4 * t1 + t3;
    let t5 = 4 * t0 + t2;

    let out0 = t3 + t5;
    let out1 = t5;
    let out2 = t2 + t4;
    let out3 = t4;

    return [out0, out1, out2, out3];
}

fn poseidon2_init_state(h: felt[12]) -> felt[12] {
    let b0 = matmul_m4([h[0], h[1], h[2], h[3]]);
    let b1 = matmul_m4([h[4], h[5], h[6], h[7]]);
    let b2 = matmul_m4([h[8], h[9], h[10], h[11]]);

    let sum0 = b0[0] + b1[0] + b2[0];
    let sum1 = b0[1] + b1[1] + b2[1];
    let sum2 = b0[2] + b1[2] + b2[2];
    let sum3 = b0[3] + b1[3] + b2[3];

    return [
        b0[0] + sum0, b0[1] + sum1, b0[2] + sum2, b0[3] + sum3,
        b1[0] + sum0, b1[1] + sum1, b1[2] + sum2, b1[3] + sum3,
        b2[0] + sum0, b2[1] + sum1, b2[2] + sum2, b2[3] + sum3
    ];
}

fn poseidon2_external_state(h: felt[12]) -> felt[12] {
    let s0 = pow7(h[0] + ark_ext_0);
    let s1 = pow7(h[1] + ark_ext_1);
    let s2 = pow7(h[2] + ark_ext_2);
    let s3 = pow7(h[3] + ark_ext_3);
    let s4 = pow7(h[4] + ark_ext_4);
    let s5 = pow7(h[5] + ark_ext_5);
    let s6 = pow7(h[6] + ark_ext_6);
    let s7 = pow7(h[7] + ark_ext_7);
    let s8 = pow7(h[8] + ark_ext_8);
    let s9 = pow7(h[9] + ark_ext_9);
    let s10 = pow7(h[10] + ark_ext_10);
    let s11 = pow7(h[11] + ark_ext_11);

    let b0 = matmul_m4([s0, s1, s2, s3]);
    let b1 = matmul_m4([s4, s5, s6, s7]);
    let b2 = matmul_m4([s8, s9, s10, s11]);

    let sum0 = b0[0] + b1[0] + b2[0];
    let sum1 = b0[1] + b1[1] + b2[1];
    let sum2 = b0[2] + b1[2] + b2[2];
    let sum3 = b0[3] + b1[3] + b2[3];

    return [
        b0[0] + sum0, b0[1] + sum1, b0[2] + sum2, b0[3] + sum3,
        b1[0] + sum0, b1[1] + sum1, b1[2] + sum2, b1[3] + sum3,
        b2[0] + sum0, b2[1] + sum1, b2[2] + sum2, b2[3] + sum3
    ];
}

fn poseidon2_internal_state(h: felt[12]) -> felt[12] {
    let i0 = pow7(h[0] + ark_int);
    let sum_int = i0 + h[1] + h[2] + h[3] + h[4] + h[5] + h[6] + h[7] + h[8] + h[9] + h[10] + h[11];

    return [
        i0 * MAT_DIAG[0] + sum_int,
        h[1] * MAT_DIAG[1] + sum_int,
        h[2] * MAT_DIAG[2] + sum_int,
        h[3] * MAT_DIAG[3] + sum_int,
        h[4] * MAT_DIAG[4] + sum_int,
        h[5] * MAT_DIAG[5] + sum_int,
        h[6] * MAT_DIAG[6] + sum_int,
        h[7] * MAT_DIAG[7] + sum_int,
        h[8] * MAT_DIAG[8] + sum_int,
        h[9] * MAT_DIAG[9] + sum_int,
        h[10] * MAT_DIAG[10] + sum_int,
        h[11] * MAT_DIAG[11] + sum_int
    ];
}


##########################################################################################
# CONSTANTS AND PERIODIC COLUMNS
##########################################################################################

const MAT_DIAG = [
    14102670999874605824, 15585654191999307702, 940187017142450255,
    8747386241522630711, 6750641561540124747, 7440998025584530007,
    6136358134615751536, 12413576830284969611, 11675438539028694709,
    17580553691069642926, 892707462476851331, 15167485180850043744
