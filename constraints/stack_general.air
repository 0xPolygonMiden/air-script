##########################################################################################
# STACK GENERAL CONSTRAINTS MODULE
##########################################################################################
#
# Enforces general stack transition constraints based on op flags and shift behavior.
# Tagging is applied at the call site in the main module.
##########################################################################################

mod stack_general
use flags::*;

# Requires stack columns and decoder op bits/e-bits.

ev stack_general_transition([stack[16], decoder[24]]) {
    # STACK TRANSITION MODEL
    # ------------------------------------
    # For each stack position i, the next value s_i' is determined by exactly one of three
    # mutually exclusive shift behaviors:
    #   - no_shift_i: position i keeps its value (s_i' = s_i)
    #   - left_shift_{i+1}: position i takes the value from i+1 (s_i' = s_{i+1})
    #   - right_shift_{i-1}: position i takes the value from i-1 (s_i' = s_{i-1})
    #
    # The constraint uses the standard weighted form:
    #   s_i' * (no_shift_i + left_shift_{i+1} + right_shift_{i-1})
    #       = no_shift_i * s_i + left_shift_{i+1} * s_{i+1} + right_shift_{i-1} * s_{i-1}.
    #
    # At the edges we drop the invalid term (i=0 has no right_shift_{-1}, i=15 has no left_shift_16).

    let s0 = stack[0];
    let s1 = stack[1];
    let s2 = stack[2];
    let s3 = stack[3];
    let s4 = stack[4];
    let s5 = stack[5];
    let s6 = stack[6];
    let s7 = stack[7];
    let s8 = stack[8];
    let s9 = stack[9];
    let s10 = stack[10];
    let s11 = stack[11];
    let s12 = stack[12];
    let s13 = stack[13];
    let s14 = stack[14];
    let s15 = stack[15];

    # b0..b6 are the 7 opcode bits (LSB -> MSB) used by op flag helpers.
    # e0/e1 are the two extra op-bit columns used for degree reduction.
    # h5, the 5th helper register, is the loop-end flag used by END to decide whether it shifts the stack.
    let b0 = decoder[1];
    let b1 = decoder[2];
    let b2 = decoder[3];
    let b3 = decoder[4];
    let b4 = decoder[5];
    let b5 = decoder[6];
    let b6 = decoder[7];
    let e0 = decoder[22];
    let e1 = decoder[23];
    let h5 = decoder[13];

    let op_bits = [b0, b1, b2, b3, b4, b5, b6];

    # Operation flags (degree 7/6/5/4 groups)
    let is_noop = flag_noop(op_bits);
    let is_swap = flag_swap(op_bits);
    let is_movup2 = flag_movup2(op_bits);
    let is_movdn2 = flag_movdn2(op_bits);
    let is_movup3 = flag_movup3(op_bits);
    let is_movdn3 = flag_movdn3(op_bits);
    let is_advpopw = flag_advpopw(op_bits);
    let is_movup4 = flag_movup4(op_bits);
    let is_movdn4 = flag_movdn4(op_bits);
    let is_movup5 = flag_movup5(op_bits);
    let is_movdn5 = flag_movdn5(op_bits);
    let is_movup6 = flag_movup6(op_bits);
    let is_movdn6 = flag_movdn6(op_bits);
    let is_movup7 = flag_movup7(op_bits);
    let is_movdn7 = flag_movdn7(op_bits);
    let is_swapw = flag_swapw(op_bits);
    let is_ext2mul = flag_ext2mul(op_bits);
    let is_movup8 = flag_movup8(op_bits);
    let is_movdn8 = flag_movdn8(op_bits);
    let is_swapw2 = flag_swapw2(op_bits);
    let is_swapw3 = flag_swapw3(op_bits);
    let is_emit = flag_emit(op_bits);

    let is_assert = flag_assert(op_bits);
    let is_eqz = flag_eqz(op_bits);
    let is_neg = flag_neg(op_bits);
    let is_inv = flag_inv(op_bits);
    let is_incr = flag_incr(op_bits);
    let is_not = flag_not(op_bits);
    let is_eq = flag_eq(op_bits);
    let is_add = flag_add(op_bits);
    let is_mul = flag_mul(op_bits);
    let is_and = flag_and(op_bits);
    let is_or = flag_or(op_bits);
    let is_u32and = flag_u32and(op_bits);
    let is_u32xor = flag_u32xor(op_bits);
    let is_frie2f4 = flag_frie2f4(op_bits);
    let is_drop = flag_drop(op_bits);
    let is_cswap = flag_cswap(op_bits);
    let is_cswapw = flag_cswapw(op_bits);
    let is_mload = flag_mload(op_bits);
    let is_mloadw = flag_mloadw(op_bits);
    let is_mstore = flag_mstore(op_bits);
    let is_mstorew = flag_mstorew(op_bits);

    let is_u32add = flag_u32add(op_bits);
    let is_u32sub = flag_u32sub(op_bits);
    let is_u32mul = flag_u32mul(op_bits);
    let is_u32div = flag_u32div(op_bits);
    let is_u32split = flag_u32split(op_bits);
    let is_u32assert2 = flag_u32assert2(op_bits);
    let is_u32add3 = flag_u32add3(op_bits);
    let is_u32madd = flag_u32madd(op_bits);

    let is_expacc = flag_expacc(op_bits);

    let is_hperm = flag_hperm(op_bits, e0);
    let is_mpverify = flag_mpverify(op_bits, e0);
    let is_pipe = flag_pipe(op_bits, e0);
    let is_mstream = flag_mstream(op_bits, e0);
    let is_split = flag_split(op_bits, e0);
    let is_loop = flag_loop(op_bits, e0);
    let is_span = flag_span(op_bits, e0);
    let is_join = flag_join(op_bits, e0);
    let is_dyn = flag_dyn(op_bits, e0);
    let is_push = flag_push(op_bits, e0);
    let is_dyncall = flag_dyncall(op_bits, e0);

    let is_mrupdate = flag_mrupdate(op_bits, e1);
    let is_call = flag_call(op_bits, e1);
    let is_end = flag_end(op_bits, e1);
    let is_repeat = flag_repeat(op_bits, e1);
    let is_respan = flag_respan(op_bits, e1);
    let is_halt = flag_halt(op_bits, e1);

    let is_pad = flag_pad(op_bits);
    let is_dup = flag_dup(op_bits);
    let is_dup1 = flag_dup1(op_bits);
    let is_dup2 = flag_dup2(op_bits);
    let is_dup3 = flag_dup3(op_bits);
    let is_dup4 = flag_dup4(op_bits);
    let is_dup5 = flag_dup5(op_bits);
    let is_dup6 = flag_dup6(op_bits);
    let is_dup7 = flag_dup7(op_bits);
    let is_dup9 = flag_dup9(op_bits);
    let is_dup11 = flag_dup11(op_bits);
    let is_dup13 = flag_dup13(op_bits);
    let is_dup15 = flag_dup15(op_bits);
    let is_clk = flag_clk(op_bits);

    let is_swapdw = flag_swapdw(op_bits);
    let is_caller = flag_caller(op_bits);
    let is_sdepth = flag_sdepth(op_bits);
    let is_hornerbase = flag_hornerbase(op_bits, e0);
    let is_hornerext = flag_hornerext(op_bits, e0);
    let is_evalcircuit = flag_evalcircuit(op_bits, e0);
    let is_logprecompile = flag_logprecompile(op_bits, e0);
    let is_cryptostream = flag_cryptostream(op_bits, e1);

    # PREFIX FLAGS FOR SHIFT SETS
    # ---------------------------
    # These are the (b6..b3) prefixes used by the Rust op_flags construction:
    # - prefix_0000: no-shift group (e.g., NOOP/EQZ/NEG/INV/INCR/NOT/MLOAD + SWAP/CALLER/MOV*)
    # - prefix_0100: left-shift group (ASSERT/EQ/ADD/MUL/AND/OR/U32AND/U32XOR/FRIE2F4/...),
    # - prefix_011: right-shift group (PAD/DUP*/ADVPOP/SDEPTH/CLK)
    # - prefix_1000: u32 arithmetic group (U32ADD/U32SUB/U32MUL/U32DIV/U32SPLIT/U32ASSERT2/U32ADD3/U32MADD)
    # Using them avoids repeating the same bit products in every shift set while keeping the
    # formulas identical.
    let f011 = prefix_011(op_bits);
    let f0000 = prefix_0000(op_bits);
    let f0100 = prefix_0100(op_bits);
    let f1000 = prefix_1000(op_bits);

    # Unused opcode 47 (010_1111) sits in the 010-prefix (left-shift) group, so it is
    # included in the prefix-based left-shift polynomial even though it is unreachable.
    # Keeping it here matches the Rust compact formulation exactly.
    let op_47 = opcode_47(op_bits);

    # no_change_1_flag: this is the "rest of the 0000 group".
    # We already placed NOOP into no_shift_0 (position 0). For position 1, we want
    # *every* 0000‑prefix op *except* NOOP, so we take the prefix and subtract NOOP.
    let no_change_1_flag = f0000 - is_noop;
    # left_change_1_flag: this is the "rest of the 0100 left‑shift prefix".
    # ASSERT is already accounted for in left_shift_1, so we remove it from the prefix.
    let left_change_1_flag = f0100 - is_assert;
    # shift_left_on_end: END only removes a stack item when it *closes a loop*.
    # The decoder exposes this as h5 (is_loop_end), so we gate END by h5.
    let shift_left_on_end = is_end * h5;
    # split_loop_flag: SPLIT and LOOP both remove one item from the stack, so they share
    # the same left‑shift behavior and can be grouped.
    let split_loop_flag = is_split + is_loop;
    # add3_madd_flag: U32ADD3 and U32MADD both consume three operands, so they share the
    # same left‑shift behavior and can be grouped.
    let add3_madd_flag = is_u32add3 + is_u32madd;

    # MOV/SWAP PREFIX HELPERS
    # -----------------------
    # The mov*_prefix flags match both MOVUPn and MOVDNn for a fixed n. These opcodes share
    # all bits except b0, so the prefix excludes b0 and sums both directions.
    #
    # This is crucial for readability: "mov2_prefix" means "a MOV of length 2 happened",
    # independent of direction, and then we decide per position whether that move implies
    # a left or a right shift.
    let mov2_prefix = mov2_flag(op_bits);
    let mov3_prefix = mov3_flag(op_bits);
    let mov4_prefix = mov4_flag(op_bits);
    let mov5_prefix = mov5_flag(op_bits);
    let mov6_prefix = mov6_flag(op_bits);
    let mov7_prefix = mov7_flag(op_bits);
    let mov8_prefix = mov8_flag(op_bits);
    let movdn_any = movdnn_flag(op_bits);
    let movup_any = movupn_flag(op_bits);
    let swapw_prefix = swapwx_flag(op_bits);
    let adv_popw_or_expacc = adv_popw_expacc(op_bits);
    let ext2mul_flag = is_ext2mul;

    # HOW TO READ THE +/- PATTERN
    # ---------------------------
    # Many ops only affect a *prefix* of the stack. For example:
    #   - MOVDN3 shifts positions 0..2 left, but positions 3..15 are unchanged.
    #   - MOVUP4 shifts positions 0..3 right, but positions 4..15 are unchanged.
    #
    # We encode that by:
    #   - adding a broad "movdn_any"/"movup_any" at shallow positions, then
    #   - subtracting the specific MOVDNn/MOVUPn flag once we reach a depth > n-1.

    # NO-SHIFT FLAGS (PER POSITION)
    # -----------------------------
    # These capture opcodes for which position i is unchanged. We build them incrementally:
    #   - start with a base set (no_shift_0),
    #   - then add or tweak for deeper positions as more ops stop affecting them.
    #
    # The adjustments (+ / -) follow the same rule as the Rust compact formulation:
    # when we move one position deeper, we either inherit the same set or remove the
    # move-length that no longer reaches that depth.
    let no_shift_0 = is_noop + is_u32assert2 + is_mpverify + is_span + is_join + is_emit
        + is_respan + is_halt + is_call + is_end * (1 - h5);
    # Position 1 adds all "0000" prefix ops except NOOP (already in no_shift_0).
    let no_shift_1 = no_shift_0 + no_change_1_flag;
    # Position 2 adds SWAP and the "1000" prefix group.
    let no_shift_2 = no_shift_1 + is_swap + f1000;
    # Positions 3..9 add the MOV prefix groups and swapw/ext2mul/mrupdate adjustments.
    let no_shift_3 = no_shift_2 + mov2_prefix;
    let no_shift_4 = no_shift_3 + mov3_prefix + adv_popw_or_expacc + swapw_prefix + ext2mul_flag + is_mrupdate;
    let no_shift_5 = no_shift_4 + mov4_prefix;
    let no_shift_6 = no_shift_5 + mov5_prefix;
    let no_shift_7 = no_shift_6 + mov6_prefix;
    let no_shift_8 = no_shift_7 + mov7_prefix + is_swapw - is_swapw2;
    let no_shift_9 = no_shift_8 + mov8_prefix;
    # Remaining positions share the same no-shift set as position 9,
    # except for swaps/hperm adjustments at depth 12.
    let no_shift_10 = no_shift_9;
    let no_shift_11 = no_shift_9;
    let no_shift_12 = no_shift_9 - is_swapw3 + is_swapw2 + is_hperm;
    let no_shift_13 = no_shift_12;
    let no_shift_14 = no_shift_12;
    let no_shift_15 = no_shift_12;

    # LEFT-SHIFT FLAGS (PER POSITION)
    # -------------------------------
    # Left shifts happen when the operation removes one or more items from the top.
    # The key pattern is: MOVDNn shifts positions 0..(n-1), but not deeper. That is why
    # we subtract is_movdn2 at position 3, is_movdn3 at position 4, etc.
    #
    # Other ops which remove items (ASSERT, DROP, MSTORE, etc.) also contribute.
    let left_shift_0 = 0;
    # Position 1: assert/drop/mstore/etc and all MOVDNn ops cause a left shift at depth 1.
    let left_shift_1 = is_assert + movdn_any + is_drop + is_mstore + op_47 + is_mstorew
        + split_loop_flag + shift_left_on_end + is_dyn + is_dyncall;
    # Position 2 adds all "0100" prefix ops except ASSERT (already in left_shift_1).
    let left_shift_2 = left_shift_1 + left_change_1_flag;
    # Position 3 adds CSWAP and the add3/madd group, but MOVDN2 stops affecting deeper positions.
    let left_shift_3 = left_shift_2 + add3_madd_flag + is_cswap - is_movdn2;
    # As depth increases, each MOVDNn ceases to affect positions deeper than n.
    let left_shift_4 = left_shift_3 - is_movdn3;
    # MLOADW adds a left shift at depth 5; then we drop MOVDN4.
    let left_shift_5 = left_shift_4 + is_mloadw - is_movdn4;
    let left_shift_6 = left_shift_5 - is_movdn5;
    let left_shift_7 = left_shift_6 - is_movdn6;
    let left_shift_8 = left_shift_7 - is_movdn7;
    # CSWAPW adds a left shift at depth 9; then we drop MOVDN8.
    let left_shift_9 = left_shift_8 + is_cswapw - is_movdn8;
    let left_shift_10 = left_shift_9;
    let left_shift_11 = left_shift_9;
    let left_shift_12 = left_shift_9;
    let left_shift_13 = left_shift_9;
    let left_shift_14 = left_shift_9;
    let left_shift_15 = left_shift_9;

    # RIGHT-SHIFT FLAGS (PER POSITION)
    # --------------------------------
    # Right shifts happen when the operation inserts new values near the top.
    # The pattern mirrors left_shift: MOVUPn shifts positions 0..(n-1) "down",
    # then stops affecting deeper positions. We subtract is_movup2 at position 2, etc.
    #
    # right_shift_0 covers all insertions at the top (PUSH, MOVUPn, and prefix 011 ops).
    let right_shift_0 = f011 + is_push + movup_any;
    # U32SPLIT inserts one extra value, so it shifts position 2 as well.
    let right_shift_1 = right_shift_0 + is_u32split;
    # As depth increases, each MOVUPn stops affecting positions deeper than n.
    let right_shift_2 = right_shift_1 - is_movup2;
    let right_shift_3 = right_shift_2 - is_movup3;
    let right_shift_4 = right_shift_3 - is_movup4;
    let right_shift_5 = right_shift_4 - is_movup5;
    let right_shift_6 = right_shift_5 - is_movup6;
    let right_shift_7 = right_shift_6 - is_movup7;
    let right_shift_8 = right_shift_7 - is_movup8;
    let right_shift_9 = right_shift_8;
    let right_shift_10 = right_shift_8;
    let right_shift_11 = right_shift_8;
    let right_shift_12 = right_shift_8;
    let right_shift_13 = right_shift_8;
    let right_shift_14 = right_shift_8;
    let right_shift_15 = right_shift_8;

    # TRANSITION CONSTRAINTS
    # ----------------------
    # Position 0: only no_shift_0 and left_shift_1 can contribute to s0'.
    let flag_sum_0 = no_shift_0 + left_shift_1;
    enf s0' * flag_sum_0 = no_shift_0 * s0 + left_shift_1 * s1;

    # Positions 1-14: each position i can pull from i (no shift), i+1 (left shift),
    # or i-1 (right shift).
    enf s1' * (no_shift_1 + left_shift_2 + right_shift_0) = no_shift_1 * s1 + left_shift_2 * s2 + right_shift_0 * s0;
    enf s2' * (no_shift_2 + left_shift_3 + right_shift_1) = no_shift_2 * s2 + left_shift_3 * s3 + right_shift_1 * s1;
    enf s3' * (no_shift_3 + left_shift_4 + right_shift_2) = no_shift_3 * s3 + left_shift_4 * s4 + right_shift_2 * s2;
    enf s4' * (no_shift_4 + left_shift_5 + right_shift_3) = no_shift_4 * s4 + left_shift_5 * s5 + right_shift_3 * s3;
    enf s5' * (no_shift_5 + left_shift_6 + right_shift_4) = no_shift_5 * s5 + left_shift_6 * s6 + right_shift_4 * s4;
    enf s6' * (no_shift_6 + left_shift_7 + right_shift_5) = no_shift_6 * s6 + left_shift_7 * s7 + right_shift_5 * s5;
    enf s7' * (no_shift_7 + left_shift_8 + right_shift_6) = no_shift_7 * s7 + left_shift_8 * s8 + right_shift_6 * s6;
    enf s8' * (no_shift_8 + left_shift_9 + right_shift_7) = no_shift_8 * s8 + left_shift_9 * s9 + right_shift_7 * s7;
    enf s9' * (no_shift_9 + left_shift_10 + right_shift_8) = no_shift_9 * s9 + left_shift_10 * s10 + right_shift_8 * s8;
    enf s10' * (no_shift_10 + left_shift_11 + right_shift_9) = no_shift_10 * s10 + left_shift_11 * s11 + right_shift_9 * s9;
    enf s11' * (no_shift_11 + left_shift_12 + right_shift_10) = no_shift_11 * s11 + left_shift_12 * s12 + right_shift_10 * s10;
    enf s12' * (no_shift_12 + left_shift_13 + right_shift_11) = no_shift_12 * s12 + left_shift_13 * s13 + right_shift_11 * s11;
    enf s13' * (no_shift_13 + left_shift_14 + right_shift_12) = no_shift_13 * s13 + left_shift_14 * s14 + right_shift_12 * s12;
    enf s14' * (no_shift_14 + left_shift_15 + right_shift_13) = no_shift_14 * s14 + left_shift_15 * s15 + right_shift_13 * s13;

    # Position 15: only no_shift_15 and right_shift_14 can contribute to s15'.
    let flag_sum_15 = no_shift_15 + right_shift_14;
    enf s15' * flag_sum_15 = no_shift_15 * s15 + right_shift_14 * s14;
}
