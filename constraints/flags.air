##########################################################################################
# FLAG HELPERS MODULE
##########################################################################################
#
# This module defines the per-op opcode flag polynomials derived from decoder op bits.
# These helpers are shared across system, stack, and decoder constraints.
# Keep these in sync with the Rust `op_flags` module.
##########################################################################################

mod flags

# SYSTEMATIC OPERATION FLAG FUNCTIONS - INDIVIDUAL FLAGS PER OP
##########################################################################################

##########################################################################################
# NO STACK SHIFT OPERATIONS (000 group) - 16 operations
##########################################################################################

fn flag_noop(bits: felt[7]) -> felt {
    return (1 - bits[6]) * (1 - bits[5]) * (1 - bits[4]) * (1 - bits[3]) * (1 - bits[2]) * (1 - bits[1]) * (1 - bits[0]);
}

fn flag_eqz(bits: felt[7]) -> felt {
    return (1 - bits[6]) * (1 - bits[5]) * (1 - bits[4]) * (1 - bits[3]) * (1 - bits[2]) * (1 - bits[1]) * bits[0];
}

