    enf s1' = s2;

    # Position 2: Gets s0 (original top element moves down to position 2)
    enf s2' = s0;

    # Positions 3-15: Unchanged (all other elements stay in place)
    enf s3' = s3;
    enf s4' = s4;
    enf s5' = s5;
    enf s6' = s6;
    enf s7' = s7;
    enf s8' = s8;
    enf s9' = s9;
    enf s10' = s10;
    enf s11' = s11;
    enf s12' = s12;
    enf s13' = s13;
    enf s14' = s14;
    enf s15' = s15;
}

