##########################################################################################
# SYSTEM CONSTRAINTS MODULE
##########################################################################################
#
# System module is responsible for managing system data, including the current VM cycle
# (clk), the free memory pointer (fmp) used for specifying the region of memory available
# to procedure locals, and the current and parent execution contexts.
#
# SYSTEM COLUMN LAYOUT (8 columns):
# ┌─────────┬──────────────────────────────────────────────────────────────────────┐
# │ Column  │                        Purpose                                       │
# ├─────────┼──────────────────────────────────────────────────────────────────────┤
# │    0    │ clk - VM execution clock (increments each cycle)                     │
# │    1    │ fmp - Free memory pointer (procedure local memory region)            │
# │    2    │ ctx - Current execution context                                      │
# │    3    │ in_syscall - System call execution flag                              │
# │   4-7   │ fn_hash - Current function digest (4 elements)                       │
# └─────────┴──────────────────────────────────────────────────────────────────────┘
#
# PROCEDURE EXECUTION MODES:
#
# The Miden VM supports five different ways to execute procedures, each with distinct
# semantics for context management, memory isolation, and caller identification:
#
# ┌──────────┬─────────┬─────────┬──────────────┬─────────────┬──────────────────────┐
# │ Operation│   ctx'  │   fmp'  │   fn_hash'   │ in_syscall' │      Purpose         │
# ├──────────┼─────────┼─────────┼──────────────┼─────────────┼──────────────────────┤
# │ EXEC     │   ctx   │   fmp   │   fn_hash    │ in_syscall  │ Inline execution     │
# │ CALL     │ clk + 1 │  2^30   │ Load new     │      0      │ Call known procedure │
# │ SYSCALL  │    0    │  2^31   │ **PRESERVE** │      1      │ Call kernel          │
# │ DYN      │   ctx   │   fmp   │ **PRESERVE** │ in_syscall  │ Dynamic inline exec  │
# │ DYNCALL  │ clk + 1 │  2^30   │ Load new     │      0      │ Dynamic call         │
# └──────────┴─────────┴─────────┴──────────────┴─────────────┴──────────────────────┘
#
# DETAILED SEMANTICS:
#
# 1. EXEC (no opcode, handled by MASM assembler):
#    - Inline execution: procedure code is inserted directly into caller
#    - No context switch, no register changes
#    - Behaves like a macro expansion at compile time
#    - Not enforced by AIR constraints (happens during assembly)
#
# 2. CALL (opcode 108: 110_1100):
#    - Creates NEW execution context (ctx' = clk + 1)
#    - Resets memory pointer to user space (fmp' = 2^30)
#    - Loads NEW function hash (fn_hash' = target procedure hash)
#    - Target hash known at compile time (in program MAST)
#    - Used for calling procedures within same account/program
#
# 3. SYSCALL (opcode 104: 110_1000):
#    - Jumps to ROOT CONTEXT (ctx' = 0, the kernel context)
#    - Resets memory pointer to kernel space (fmp' = 2^31)
#    - **PRESERVES** caller's fn_hash (fn_hash' = fn_hash)
#    - Sets in_syscall flag (in_syscall' = 1)
#    - Target verified in kernel ROM at runtime
#    - **CRITICAL**: Preserving fn_hash enables kernel to authenticate caller via
#      the `caller` instruction, which returns fn_hash of calling procedure
#
# 4. DYN (opcode 88: 101_1000):
#    - **NO CONTEXT SWITCH** (ctx' = ctx, remains in current context)
#    - Memory pointer UNCHANGED (fmp' = fmp)
#    - **PRESERVES** caller's fn_hash (fn_hash' = fn_hash)
#    - in_syscall flag UNCHANGED (in_syscall' = in_syscall)
#    - Target hash loaded from memory at address s0 (runtime determined)
#    - Used by kernel for dynamic procedure dispatch (e.g., exec_kernel_proc)
#    - **CRITICAL**: Because DYN preserves fn_hash, the authentication chain works:
#      User procedure → SYSCALL (preserves fn_hash) → DYN (preserves fn_hash)
#      → kernel can use `caller` to get original user procedure hash
#
# 5. DYNCALL (opcode 92: 101_1100):
#    - Creates NEW execution context (ctx' = clk + 1)
#    - Resets memory pointer to user space (fmp' = 2^30)
#    - Loads NEW function hash (fn_hash' = target procedure hash)
#    - Target hash loaded from memory at address s0 (runtime determined)
#    - Used for calling procedures whose hash is only known at runtime
#    - Example: note scripts, transaction scripts
#
# AUTHENTICATION FLOW EXAMPLE:
#
# Consider this call chain in a Miden transaction where a note script tries to add assets:
#   1. Note script (fn_hash = H_note) executes via DYNCALL (ctx > 0)
#   2. Note script calls account procedure (fn_hash = H_account_proc) via CALL (new ctx)
#   3. Account procedure calls kernel via SYSCALL (fn_hash still = H_account_proc, ctx → 0)
#   4. Kernel uses DYN to dispatch to kernel procedure (fn_hash still = H_account_proc)
#   5. Kernel procedure uses `caller` instruction → returns H_account_proc
#   6. Kernel looks up H_account_proc in the account's procedure table (stored at address 8224
#      in root context memory) → if found, authenticated! If not found, reject.
#
# The account's procedure table contains hashes of all authorized procedures (up to 256).
# Only procedures in this table can modify the account's state through kernel calls.
# This ensures only authorized account code can modify account state, never untrusted scripts.
#
# STACK BEHAVIOR:
# - CALL, SYSCALL: Reset stack depth to 16, preserving top 16 elements
# - DYNCALL: Resets stack depth to 16 AND shifts elements left by 1 position
#   (the target hash is loaded from memory at address s0, not consumed from stack).
#   The bottom element (s15') is pulled from the overflow table if available, or 0 if empty.
# - EXEC, DYN: No stack depth changes
#
# CONSTRAINT ENFORCEMENT:
# - EXEC: Not enforced (assembler-level transformation)
# - CALL, SYSCALL, DYNCALL: Enforced by system constraints (ctx, fmp, fn_hash transitions)
# - DYN: Enforced by DEFAULT constraints (all registers preserved except hasher)
# - END: Restores ctx and fmp from block stack, handles fn_hash restoration
#
# STATUS: Partially implemented (missing bus integration)
#
# REFERENCES:
# - System Design: https://0xmiden.github.io/miden-vm/design/main.html
##########################################################################################

mod system

use utils::*;
use decoder::*;

##########################################################################################
# SYSTEM CONSTRAINT IMPLEMENTATION
##########################################################################################

# Main system constraint evaluator - ensures proper system state transitions
# Requires decoder columns for operation flags and function hash loading
ev system_transition([system[8], decoder[24]]) {
    # Extract system columns
    let clk = system[0];
    let fmp = system[1];
    let ctx = system[2];
    let in_syscall = system[3];
    let fn_hash_0 = system[4];
    let fn_hash_1 = system[5];
    let fn_hash_2 = system[6];
    let fn_hash_3 = system[7];

    # Extract decoder columns needed for operation flags
    let b0 = decoder[1];
    let b1 = decoder[2];
    let b2 = decoder[3];
    let b3 = decoder[4];
    let b4 = decoder[5];
    let b5 = decoder[6];
    let b6 = decoder[7];
    let decoder_h0 = decoder[8];
    let decoder_h1 = decoder[9];
    let decoder_h2 = decoder[10];
    let decoder_h3 = decoder[11];
    let decoder_h4 = decoder[12];
    let decoder_h5 = decoder[13];
    let decoder_h6 = decoder[14];
    let decoder_h7 = decoder[15];
    let e0 = decoder[22];
    let e1 = decoder[23];

    # Compute operation flags (needed for all constraints)
    let f_call = flag_call([b0, b1, b2, b3, b4, b5, b6], e1);
    let f_syscall = flag_syscall([b0, b1, b2, b3, b4, b5, b6], e1);
    let f_dyncall = flag_dyncall([b0, b1, b2, b3, b4, b5, b6], e0);
    let f_end = flag_end([b0, b1, b2, b3, b4, b5, b6], e1);
    let f_fmpupdate = flag_fmpupdate([b0, b1, b2, b3, b4, b5, b6]);

    ####################################################################################
    # SYSTEM CLOCK CONSTRAINT
    ####################################################################################

    # Clock progression constraint (always active)
    enf clk' = clk + 1;

    ####################################################################################
    # FREE MEMORY POINTER CONSTRAINTS
    ####################################################################################
    #
    # Free memory pointer (fmp) marks the boundary of procedure-local memory:
    # - fmp = 2^30 (1073741824): User context memory region
    # - fmp = 2^31 (2147483648): Kernel context memory region
    #
    # Note: DYN preserves fmp, maintaining the current memory boundary.
    # This is essential for kernel dynamic dispatch, allowing the kernel to call
    # different procedures while sharing the same memory space.
    #
    ####################################################################################

    # CALL/DYNCALL: Reset FMP to 2^30 (procedure local memory region start)
    enf fmp' = 2^30 when (f_call + f_dyncall);

    # SYSCALL: Reset FMP to 2^31 (syscall local memory region start)
    enf fmp' = 2^31 when f_syscall;

    # Default: FMP unchanged for all other operations (including DYN)
    # NOTE: FMPUPDATE is handled by stack, END is handled by decoder bus
    enf fmp' = fmp when !(f_call + f_syscall + f_dyncall + f_fmpupdate + f_end);

    ####################################################################################
    # EXECUTION CONTEXT CONSTRAINTS
    ####################################################################################
    #
    # Execution context (ctx) determines memory isolation boundaries:
    # - ctx = 0: Kernel/root context
    # - ctx > 0: User contexts (one per CALL/DYNCALL)
    #
    # Note: DYN preserves ctx, meaning it executes in the current context without
    # creating a new one. This enables kernel dynamic dispatch while maintaining
    # the same memory space and execution environment.
    #
    ####################################################################################

    # CALL/DYNCALL: Create new context with ID = current_clk + 1
    enf ctx' = clk + 1 when (f_call + f_dyncall);

    # SYSCALL: Return to root context (ID = 0)
    enf ctx' = 0 when f_syscall;

    # Default: Context unchanged for all other operations (including DYN)
    # NOTE: END is handled by block stack table (restores previous ctx)
    enf ctx' = ctx when !(f_call + f_syscall + f_dyncall + f_end);

    ####################################################################################
    # SYSTEM CALL FLAG CONSTRAINTS
    ####################################################################################

    # Binary constraint: in_syscall must be 0 or 1
    enf in_syscall * (1 - in_syscall) = 0;

    # SYSCALL: Set flag to 1
    enf in_syscall' = 1 when f_syscall;

    # END: Clear flag if currently in syscall
    enf in_syscall' = 0 when f_end & in_syscall;

    # Default: flag remains unchanged for all other operations (except SYSCALL and END-in-syscall)
    enf in_syscall' = in_syscall when !(f_syscall + (f_end & in_syscall));

    ####################################################################################
    # FUNCTION HASH CONSTRAINTS
    ####################################################################################
    #
    # The function hash (fn_hash) identifies the currently executing procedure and is
    # critical for authorization. The `caller` instruction reads fn_hash to determine if
    # the calling procedure is authorized to perform kernel actions.
    #
    # Only three types of operations modify fn_hash:
    # 1. CALL/DYNCALL: Load new hash (enter new procedure context)
    # 2. SYSCALL: Preserve hash (enables kernel to authenticate caller)
    # 3. END: Restore hash from block stack (return to caller)
    #
    # Note: DYN falls into the "default" case where fn_hash is preserved.
    # In the context of procedure invocation authentication, SYSCALL → DYN maintains the caller's
    # identity through dynamic dispatch, allowing `caller` to return the original procedure hash.
    #
    ####################################################################################

    # CALL: Load function hash from decoder h0-h3
    enf fn_hash_0' = decoder_h0 when f_call;
    enf fn_hash_1' = decoder_h1 when f_call;
    enf fn_hash_2' = decoder_h2 when f_call;
    enf fn_hash_3' = decoder_h3 when f_call;

    # SYSCALL: Function hash unchanged (preserved from calling context)
    enf fn_hash_0' = fn_hash_0 when f_syscall;
    enf fn_hash_1' = fn_hash_1 when f_syscall;
    enf fn_hash_2' = fn_hash_2 when f_syscall;
    enf fn_hash_3' = fn_hash_3 when f_syscall;

    # DYNCALL: Load function hash from decoder h0-h3 (same as CALL)
    enf fn_hash_0' = decoder_h0 when f_dyncall;
    enf fn_hash_1' = decoder_h1 when f_dyncall;
    enf fn_hash_2' = decoder_h2 when f_dyncall;
    enf fn_hash_3' = decoder_h3 when f_dyncall;

    # Default: function hash remains unchanged for all other operations (including DYN)
    enf fn_hash_0' = fn_hash_0 when !(f_call + f_syscall + f_dyncall + f_end);
    enf fn_hash_1' = fn_hash_1 when !(f_call + f_syscall + f_dyncall + f_end);
    enf fn_hash_2' = fn_hash_2 when !(f_call + f_syscall + f_dyncall + f_end);
    enf fn_hash_3' = fn_hash_3 when !(f_call + f_syscall + f_dyncall + f_end);
}
