##########################################################################################
# ACE CHIPLET CONSTRAINTS MODULE
##########################################################################################
#
# The ACE (Arithmetic Circuit Evaluation) chiplet reduces the number of cycles required
# when recursively verifying a STARK proof in Miden assembly by evaluating arithmetic
# circuits and ensuring they evaluate to zero over given inputs.
#
# ACE TRACE TABLE LAYOUT:
# ┌─────────┬──────────────────────────────────────────────────────────────────────────┐
# │ Column  │                               Purpose                                    │
# ├─────────┼──────────────────────────────────────────────────────────────────────────┤
# │ sstart  │ Section start flag: 1=first row of section, 0=otherwise                 │
# │ sblock  │ Block selector: 0=READ block, 1=EVAL block                              │
# │   ctx   │ Memory access context                                                    │
# │   ptr   │ Memory pointer for reading inputs/instructions                           │
# │   clk   │ Memory access clock cycle                                                │
# │   op    │ Operation type (for EVAL block)                                          │
# │   id0   │ First node identifier                                                    │
# │  v0_0   │ First node value (first element)                                         │
# │  v0_1   │ First node value (second element)                                        │
# │   id1   │ Second node identifier                                                   │
# │  v1_0   │ Second node value (first element)                                        │
# │  v1_1   │ Second node value (second element)                                       │
# │   id2   │ Third node identifier (result node in EVAL)                             │
# │  v2_0   │ Third node value (first element)                                         │
# │  v2_1   │ Third node value (second element)                                        │
# │   m0    │ Multiplicity for wire bus operations                                     │
# └─────────┴──────────────────────────────────────────────────────────────────────────┘
#
# STATUS: Implemented (ACE constraints complete, wire bus integration active)
#
# REFERENCES:
# - ACE Design: https://0xmiden.github.io/miden-vm/design/chiplets/ace.html
##########################################################################################

mod ace

use chiplets::*;
use utils::*;

##########################################################################################
# ACE CHIPLET CONSTRAINTS
##########################################################################################

ev ace_chiplet_constraints([s0, s1, s2, s3, ace[16]]) {
    # ACE trace table columns (corrected layout)
    let sstart = ace[0];    # Section start flag
    let sblock = ace[1];    # Block selector (0=READ, 1=EVAL)
    let ctx = ace[2];       # Memory access context
    let ptr = ace[3];       # Memory pointer
    let clk = ace[4];       # Memory access clock
    let op = ace[5];        # Operation type (for EVAL block)
    let id0 = ace[6];       # First node identifier
    let v0_0 = ace[7];      # First node value (element 0)
    let v0_1 = ace[8];      # First node value (element 1)
    let id1 = ace[9];       # Second node identifier
    let v1_0 = ace[10];     # Second node value (element 0)
    let v1_1 = ace[11];     # Second node value (element 1)
    let id2 = ace[12];      # Third node identifier (result node in EVAL)
    let n_eval = ace[12];   # Total number of arithmetic operations
    let v2_0 = ace[13];     # Third node value (element 0)
    let v2_1 = ace[14];     # Third node value (element 1)
    let m0 = ace[15];       # Multiplicity for wire bus operations

    let flag_ace = flag_ace_active(s0, s1, s2, s3);
    let flag_ace_first = flag_ace_next_is_first_row(s0, s1, s2, s2');
    let flag_ace_next = flag_ace_current_and_next(s0, s1, s2, s3. s3');
    let flag_ace_last = flag_ace_last(s0, s1, s2, s3, s3');
        
    # Section and block flags constraints
    enf section_block_flags_constraints([s0, s1, s2, s2_next, s3, s3_next, sstart, sstart', sblock, id0, n_eval]);

    enf section_constraints(...) when flag_ace_next;

    # READ block constraints
    enf enforce_read_block_constraints([sstart, sblock, ctx, ptr, clk, id0, v0_0, v0_1, id1, v1_0, v1_1, id2, v2_0, v2_1, m0]) when flag_ace;

    # EVAL block constraints
    enf enforce_eval_block_constraints([sstart, sblock, ctx, ptr, clk, op, id0, v0_0, v0_1, id1, v1_0, v1_1, id2, v2_0, v2_1, m0]) when flag_ace;

    # Finalization constraints
    let f_end = binary_or(binary_and(flag_ace_next, sstart'), flag_ace_last); 
    enf finalization_constraints(...) when f_end;
}

##########################################################################################
# HELPER EVALUATORS
##########################################################################################

# Constrains binary columns for flags and selectors
ev enforce_binary_columns([sstart, sblock]) {
    # Section start flag must be binary
    enf is_binary([sstart]);

    # Block selector must be binary
    enf is_binary([sblock]);
}

ev section_block_flags_constraints([s0, s1, s2, s2_next, s3, s3_next, sstart, sstart', sblock, id0, n_eval]) {
        
    let flag_ace = flag_ace_active(s0, s1, s2, s3);
    let flag_ace_first = flag_ace_next_is_first_row(s0, s1, s2, s2');
    let flag_ace_next = flag_ace_current_and_next(s0, s1, s2, s3. s3');
    let flag_ace_last = flag_ace_last(s0, s1, s2, s3, s3');
        
    let section_flags = section_flags(s0, s1, s2, s3, s3', sstart, sstart');
    let f_start = section_flags[0];
    let f_next = section_flags[1];
    let f_end = section_flags[2];

    let block_flags = block_flags(s_block);
    let block_flags_next = block_flags(s_block');
    let f_read = block_flags[0];
    let f_eval = block_flags[1];
    let f_read_next = block_flags_next[0];
    let f_eval_next = block_flags_next[1];


    enf enforce_binary_columns([sstart, sblock]) when flag_ace;

    enf binary_not(sstart') when flag_ace_first;

    enf sstart = 0 when flag_ace_last;

    enf binary_and(sstart, sstart') = 0 when flag_ace_next;


    enf f_eval = 0 when f_start;

    enf f_read_next = 0 when binary_and(f_next, f_eval);

    enf f_read = 0 when f_end;

    enf select(f_read_next, n_eval', id0') = n_eval when binary_and(f_ace, f_read);
}

# READ block operation constraints
ev enforce_read_block_constraints([sstart, sblock, ctx, ptr, clk, id0, v0_0, v0_1, id1, v1_0, v1_1, id2, v2_0, v2_1, m0]) {
    let is_read_block = binary_not(sblock);

    # In READ block, we read two extension field elements and assign node IDs
    # Node IDs should be decremented for new nodes
    enf is_read_block * (id0' - (id0 + 2)) = 0;
    enf is_read_block * (id1' - (id1 - 1)) = 0;

    # Memory pointer increments by 2 in READ block (reading 2 extension field elements)
    enf is_read_block * (ptr' - (ptr + 4)) = 0;

    # In READ block, id2 and v2 are used for additional node data
    # m0 contains multiplicity information for wire bus operations
    enf is_read_block * (m0 - 1) = 0;      # Standard multiplicity for insertions
}

# EVAL block operation constraints
ev enforce_eval_block_constraints([sstart, sblock, ctx, ptr, clk, op, id0, v0_0, v0_1, id1, v1_0, v1_1, id2, v2_0, v2_1, m0]) {
    let is_eval_block = sblock;

    # In EVAL block, we decode instruction and perform arithmetic operation
    # The 'op' column contains the operation type

    # Memory pointer increments by 1 in EVAL block (reading 1 instruction)
    enf is_eval_block * (ptr' - (ptr + 1)) = 0;

    # Wire bus operations: consume two inputs, produce one output
    # For EVAL operations, we consume id0 and id1, produce result in id2
    enf is_eval_block * (m0 + 1) = 0;      # Consume nodes (negative multiplicity for consumption)

    # In EVAL block, id2 represents the result node ID
    # v2_0, v2_1 represent the result node value as extension field element
    # Arithmetic operation constraint based on op type
    enf enforce_arithmetic_operation([op, v0_0, v0_1, v1_0, v1_1, v2_0, v2_1]) when is_eval_block;
}

# Wire bus mechanism constraints
ev enforce_wire_bus_constraints([sblock, id0, v0_0, v0_1, id1, v1_0, v1_1, id2, v2_0, v2_1, m0]) {
    # Wire bus tracks node insertions and consumptions using logUp argument
    # Each (id, value) pair must be inserted exactly as many times as consumed
    # Extension field elements are represented as pairs (v_0, v_1)

    let is_read_block = binary_not(sblock);
    let is_eval_block = sblock;

    # Bus interaction for first node (extension field element)
    enf bus_ace_wire.insert(id0, v0_0, v0_1) with m0 when is_read_block;  # READ inserts
    enf bus_ace_wire.remove(id0, v0_0, v0_1) with m0 when is_eval_block;  # EVAL consumes

    # Bus interaction for second node (extension field element)
    enf bus_ace_wire.insert(id1, v1_0, v1_1) with m0 when is_read_block;  # READ inserts
    enf bus_ace_wire.remove(id1, v1_0, v1_1) with m0 when is_eval_block;  # EVAL consumes

    # Result node insertion in EVAL block
    # id2 acts as result node ID, v2_0/v2_1 as result extension field element
    enf bus_ace_wire.insert(id2, v2_0, v2_1) with 1 when is_eval_block;  # EVAL produces result
}

# Arithmetic operation evaluation for EVAL block
ev enforce_arithmetic_operation([op, v0_0, v0_1, v1_0, v1_1, v2_0, v2_1]) {
    # Decode operation and enforce arithmetic constraint for extension field elements
    # Extension field elements are represented as (a_0, a_1) where element = a_0 + a_1 * α

    # For demonstration: assume basic operations
    # op = 0: ADD, op = 1: SUB, op = 2: MUL
    let is_add = (1 - op) * (2 - op);      # op = 0
    let is_sub = op * (2 - op);            # op = 1
    let is_mul = op * (op - 1);            # op = 2

    # For extension field addition: (a_0 + a_1*α) + (b_0 + b_1*α) = (a_0+b_0) + (a_1+b_1)*α
    enf is_add * (v2_0 - (v0_0 + v1_0)) = 0;  # Result element 0
    enf is_add * (v2_1 - (v0_1 + v1_1)) = 0;  # Result element 1

    # For extension field subtraction: (a_0 + a_1*α) - (b_0 + b_1*α) = (a_0-b_0) + (a_1-b_1)*α
    enf is_sub * (v2_0 - (v0_0 - v1_0)) = 0;  # Result element 0
    enf is_sub * (v2_1 - (v0_1 - v1_1)) = 0;  # Result element 1

    # For extension field multiplication: (a_0 + a_1*α) * (b_0 + b_1*α)
    # = a_0*b_0 + a_1*b_1*α^2 + (a_0*b_1 + a_1*b_0)*α
    # Simplified assuming α^2 = -1 (common extension field property)
    enf is_mul * (v2_0 - (v0_0 * v1_0 - v0_1 * v1_1)) = 0;  # Real part
    enf is_mul * (v2_1 - (v0_0 * v1_1 + v0_1 * v1_0)) = 0;  # Imaginary part
}

# Valid block transition patterns
ev enforce_valid_block_transitions([sstart, sblock]) {
    # Block transitions should follow valid patterns
    # READ blocks can transition to EVAL blocks
    # EVAL blocks can transition to READ blocks (new section) or continue EVAL

    let is_read_to_eval = binary_not(sblock) * sblock';
    let is_eval_to_read = sblock * binary_not(sblock') * sstart';
    let is_eval_to_eval = sblock * sblock' * binary_not(sstart');

    # Valid transitions
    enf (is_read_to_eval + is_eval_to_read + is_eval_to_eval) <= 1;
}

##########################################################################################
# HELPER FUNCTIONS
##########################################################################################

# ACE chiplet active flag
fn flag_ace_active(s0: felt, s1: felt, s2: felt, s3: felt) -> felt {
    return s0 * s1 * s2 * binary_not(s3);  # Pattern for ACE chiplet selector
}

fn flag_previous_chip_active(s0: felt, s1: felt, s2: felt) -> felt {
    return s0 * s1 * (1 - s2);
}

fn flag_ace_next_is_first_row(s0: felt, s1: felt, s2: felt, s2_next: felt) -> felt {
    return flag_previous_chip_active(s0, s1, s2) * !s2_next;
}

fn flag_ace_current_and_next(s0: felt, s1: felt, s2: felt, s3: felt, s3_next: felt) -> felt {
    return flag_ace_active(s0, s1, s2, s3) * !s3_next;
}

fn flag_ace_last(s0: felt, s1: felt, s2: felt, s3: felt, s3_next: felt) -> felt {
    return flag_ace_active(s0, s1, s2, s3) * s3_next;
}

fn section_flags(s0: felt, s1: felt, s2: felt, s3: felt, s3_next: felt, s_start: felt, s_start_next: felt) -> felt[3] {
    let f_ace = flag_ace_active(s0, s1, s2, s3);
    let f_ace_next = flag_ace_current_and_next(s0, s1, s2, s3, s3_next);
    let f_ace_last = flag_ace_last(s0, s1, s2, s3, s3_next);
    
    let f_start = binary_and(f_ace, s_start);
    let f_next = binary_and(f_ace_next, !s_start_next);
    let f_end = binary_or(binary_and(f_ace_next, s_start_next), f_ace_last); # not flags are mutually exclusive

    return [f_start, f_next, f_end];
}

fn block_flags(s_block: felt) -> felt[2] {
    let f_read = !s_block;
    let f_eval = s_block;

    return [f_read, f_eval];
}

