##########################################################################################
# MIDEN VM - ALGEBRAIC INTERMEDIATE REPRESENTATION (AIR) CONSTRAINTS
##########################################################################################
#
# The Miden Virtual Machine is a STARK-based zero-knowledge virtual machine designed for
# efficient execution and proving of arbitrary computations. This AIR specification defines
# the arithmetic constraints that govern the VM's execution.
#
# STATUS: Partial.
#
# REFERENCES:
# - Miden VM implementation: https://0xmiden.github.io/miden-vm/
# - Miden VM documentation : https://0xmiden.github.io/miden-vm/intro/main.html
##########################################################################################

def MidenVM

# Constraint IDs must cover 0..=CURRENT_MAX_ID with no duplicates.
const CURRENT_MAX_ID = 16;

use flags::*;
use system::*;
use range_checker::*;

##########################################################################################
# EXECUTION TRACE LAYOUT
##########################################################################################

trace_columns {
    main: [system[6], decoder[24], stack[19], range_checker[2], chiplets[20], padding[1]],
}

##########################################################################################
# PUBLIC INPUTS
##########################################################################################

public_inputs {
    dummy: [1],
}

##########################################################################################
# BUS ARCHITECTURE
##########################################################################################
#
# Keep the full bus list to preserve auxiliary column ordering. Only the range checker bus
# is constrained in this group (tag 16).
##########################################################################################

buses {
    # Decoder buses
    multiset bus_0_decoder_p1,
    multiset bus_1_decoder_p2,
    multiset bus_2_decoder_p3,

    # Stack overflow table
    multiset bus_3_stack_p1,

    # Range checker bus
    logup    bus_4_range_checker @tag_transition(16),

    # Chiplet buses
    multiset bus_5_v_table,
    multiset bus_6_chiplets_bus,

    # Wiring bus
    logup    bus_7_wiring_bus,
}

##########################################################################################
# BOUNDARY CONSTRAINTS
##########################################################################################

boundary_constraints {
    # System clock must start at 0
    @tag(0) enf system[0].first = 0;

    # Range checker value column must span [0, 65535]
    @tag(13) enf range_checker[1].first = 0;
    @tag(14) enf range_checker[1].last = 65535;

    # Leave bus boundaries unconstrained as these will be handled using the uniform
    # treatment for auxiliary columns boundary constraints, i.e.,
    #
    # 1- Initial row valuess are either 0/1 for LogUp or Multi-set,
    # 2- Final row values are constrained using aux_finals values
    #
    enf bus_0_decoder_p1.first = unconstrained;
    enf bus_0_decoder_p1.last = unconstrained;
    enf bus_1_decoder_p2.first = unconstrained;
    enf bus_1_decoder_p2.last = unconstrained;
    enf bus_2_decoder_p3.first = unconstrained;
    enf bus_2_decoder_p3.last = unconstrained;
    enf bus_3_stack_p1.first = unconstrained;
    enf bus_3_stack_p1.last = unconstrained;
    enf bus_4_range_checker.first = unconstrained;
    enf bus_4_range_checker.last = unconstrained;
    enf bus_5_v_table.first = unconstrained;
    enf bus_5_v_table.last = unconstrained;
    enf bus_6_chiplets_bus.first = unconstrained;
    enf bus_6_chiplets_bus.last = unconstrained;
    enf bus_7_wiring_bus.first = unconstrained;
    enf bus_7_wiring_bus.last = unconstrained;
}

##########################################################################################
# INTEGRITY CONSTRAINTS
##########################################################################################

integrity_constraints {
    # System transitions (tags 1..12)
    @tag_range(1..13) enf system_transition([system[0..6], decoder[0..24]]);

    # Range checker transition (tag 15)
    @tag(15) enf range_checker_constraints([decoder[0..24], range_checker[0..2], chiplets[0..20]]);
}
