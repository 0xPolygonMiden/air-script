##########################################################################################
# STACK CRYPTO CONSTRAINTS MODULE
##########################################################################################
#
# Enforces crypto-related stack operation semantics (cryptostream, hornerbase, hornerext).
# Tagging is applied at the call site in the main module.
##########################################################################################

mod stack_crypto
use flags::*;

ev stack_crypto_transition([stack[19], decoder[24], system[6]]) {
    let [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15,
         stack_b0_unused, stack_b1_unused, stack_h0_unused] = stack;

    let [system_clk_unused, system_ctx_unused, system_fn_hash_0_unused, system_fn_hash_1_unused,
         system_fn_hash_2_unused, system_fn_hash_3_unused] = system;

    # b0..b6 are the 7 opcode bits (LSB -> MSB) used by op flag helpers.
    # h0..h5 are user op helpers used by horner operations.
    # e0/e1 are the two extra op-bit columns used for degree reduction.
    let [
        d0_unused,
        b0,
        b1,
        b2,
        b3,
        b4,
        b5,
        b6,
        d8_unused,
        d9_unused,
        h0,
        h1,
        h2,
        h3,
        h4,
        h5,
        d16_unused,
        d17_unused,
        d18_unused,
        d19_unused,
        d20_unused,
        d21_unused,
        e0,
        e1
    ] = decoder;

    let op_bits = [b0, b1, b2, b3, b4, b5, b6];

    let is_cryptostream = flag_cryptostream(op_bits, e1);
    let is_hornerbase = flag_hornerbase(op_bits, e0);
    let is_hornerext = flag_hornerext(op_bits, e0);

    # Dummy term to force constraints into the transition domain when needed.
    let zero = s0' - s0';

    # ------------------------------------------------------------------------------------------
    # CRYPTOSTREAM
    # ------------------------------------------------------------------------------------------
    # Positions 8-11: Unchanged (capacity preserved)
    let cryptostream_keep_top = [s8' - s8, s9' - s9, s10' - s10, s11' - s11];
    enf cryptostream_keep_top[i] = 0 for i in 0..4 when is_cryptostream;
    # Positions 12-13: Source/destination pointers incremented by 8 (2 words)
    let cryptostream_bump = [s12' - (s12 + 8), s13' - (s13 + 8)];
    enf cryptostream_bump[i] = 0 for i in 0..2 when is_cryptostream;
    # Positions 14-15: Unchanged
    let cryptostream_keep_tail = [s14' - s14, s15' - s15];
    enf cryptostream_keep_tail[i] = 0 for i in 0..2 when is_cryptostream;

    # ------------------------------------------------------------------------------------------
    # HORNERBASE
    # ------------------------------------------------------------------------------------------
    # Positions 0-13: Unchanged
    let hornerbase_keep = [
        s0' - s0, s1' - s1, s2' - s2, s3' - s3, s4' - s4, s5' - s5, s6' - s6,
        s7' - s7, s8' - s8, s9' - s9, s10' - s10, s11' - s11, s12' - s12, s13' - s13
    ];
    enf hornerbase_keep[i] = 0 for i in 0..14 when is_hornerbase;

    # Local variables for readability
    let a0 = h0; let a1 = h1;
    let acc0 = s14; let acc1 = s15;
    let tmp0_0 = h4; let tmp0_1 = h5;
    let tmp1_0 = h2; let tmp1_1 = h3;

    # Precompute alpha powers.
    let a0_sq = a0^2;
    let a1_sq = a1^2;
    let a0_a1 = a0 * a1;
    let a0_cu = a0_sq * a0;
    let a1_cu = a1_sq * a1;

    let alpha_sq_0 = a0_sq + 7 * a1_sq;
    let alpha_sq_1 = 2 * a0_a1;

    let alpha_cu_0 = a0_cu + 21 * a0 * a1_sq;
    let alpha_cu_1 = 3 * a0_sq * a1 + 7 * a1_cu;

    # tmp0 = acc·α² + c0·α + c1
    enf tmp0_0 - (acc0 * alpha_sq_0 + acc1 * (7 * alpha_sq_1) + s0 * a0 + s1) = zero when is_hornerbase;
    enf tmp0_1 - (acc0 * alpha_sq_1 + acc1 * alpha_sq_0 + s0 * a1) = zero when is_hornerbase;

    # tmp1 = tmp0·α³ + c2·α² + c3·α + c4
    enf tmp1_0 - (tmp0_0 * alpha_cu_0 + tmp0_1 * (7 * alpha_cu_1)
        + s2 * alpha_sq_0 + s3 * a0 + s4) = zero when is_hornerbase;
    enf tmp1_1 - (tmp0_0 * alpha_cu_1 + tmp0_1 * alpha_cu_0
        + s2 * alpha_sq_1 + s3 * a1) = zero when is_hornerbase;

    # acc' = tmp1·α³ + c5·α² + c6·α + c7
    enf s14' - (tmp1_0 * alpha_cu_0 + tmp1_1 * (7 * alpha_cu_1)
        + s5 * alpha_sq_0 + s6 * a0 + s7) = 0 when is_hornerbase;
    enf s15' - (tmp1_0 * alpha_cu_1 + tmp1_1 * alpha_cu_0
        + s5 * alpha_sq_1 + s6 * a1) = 0 when is_hornerbase;

    # ------------------------------------------------------------------------------------------
    # HORNEREXT
    # ------------------------------------------------------------------------------------------
    # Positions 0-13: Unchanged
    let hornerext_keep = [
        s0' - s0, s1' - s1, s2' - s2, s3' - s3, s4' - s4, s5' - s5, s6' - s6,
        s7' - s7, s8' - s8, s9' - s9, s10' - s10, s11' - s11, s12' - s12, s13' - s13
    ];
    enf hornerext_keep[i] = 0 for i in 0..14 when is_hornerext;

    let tmp0 = h4;
    let tmp1 = h5;

    # acc_tmp = acc·α² + c0·α + c1
    enf tmp0 - (acc0 * alpha_sq_0 + acc1 * (7 * alpha_sq_1)
        + s0 * a0 + 7 * s1 * a1 + s2) = zero when is_hornerext;
    enf tmp1 - (acc1 * alpha_sq_0 + acc0 * alpha_sq_1
        + s1 * a0 + s0 * a1 + s3) = zero when is_hornerext;

    # acc' = acc_tmp·α² + c2·α + c3
    enf s14' - (tmp0 * alpha_sq_0 + tmp1 * (7 * alpha_sq_1)
        + s4 * a0 + 7 * s5 * a1 + s6) = 0 when is_hornerext;
    enf s15' - (tmp1 * alpha_sq_0 + tmp0 * alpha_sq_1
        + s5 * a0 + s4 * a1 + s7) = 0 when is_hornerext;
}
