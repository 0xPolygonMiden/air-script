mod range_checker

use chiplets::*;
use utils::*;

### Range checker bus constraints #################################################################

ev range_checker_constraints([decoder[24], range_checker[2], chiplets[20]]) {

    # Top 4 operand stack elements to be range-checked
    let sv0 = decoder[10];
    let sv1 = decoder[11];
    let sv2 = decoder[12];
    let sv3 = decoder[13];
    
    # Memory chiplet values to be range-checked
    let mv0 = chiplets[14];
    let mv1 = chiplets[15];

    # Range checker columns, these are the
    #
    # 1. values in the range [0, 2^16 - 1] we perform the range checks against, and
    # 2. the multiplicity of each of the values in the range [0, 2^16 - 1]
    let value = range_checker[1];
    let multiplicity = range_checker[0];

    # U32 range check operation flag computation
    # This flag indicates a stack operation which performs range checks
    let not_4 = binary_not(decoder[5]);
    let not_5 = binary_not(decoder[6]);
    let u32_rc_op = decoder[7] * not_4 * not_5;

    # Chiplets memory flag computation
    let s_0 = chiplets[0];
    let s_1 = chiplets[1];
    let s_2 = chiplets[2];
    let chiplets_memory_flag = memory_chiplet_flag(s_0, s_1, s_2);

    # The range checks

    ## Memory-related range checks.
    bus_4_range_checker.insert(value) with multiplicity;
    bus_4_range_checker.remove(mv0) when chiplets_memory_flag;
    bus_4_range_checker.remove(mv1) when chiplets_memory_flag;

    ## Stack-related range checks.
    bus_4_range_checker.remove(sv0) when u32_rc_op;
    bus_4_range_checker.remove(sv1) when u32_rc_op;
    bus_4_range_checker.remove(sv2) when u32_rc_op;
    bus_4_range_checker.remove(sv3) when u32_rc_op;
}
