##########################################################################################
# STACK OPS CONSTRAINTS MODULE
##########################################################################################
#
# Enforces stack operation semantics that directly rewrite stack items (pad/dup/swap/mov/swapw,
# conditional swaps, and small system/io stack ops). Tagging is applied at the call site in the
# main module.
##########################################################################################

mod stack_ops
use flags::*;
use utils::*;

ev stack_ops_transition([stack[19], decoder[24], system[6]]) {
    let [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15,
         stack_b0, stack_b1_unused, stack_h0_unused] = stack;
    let s = [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15];

    let [system_clk, system_ctx, system_fn_hash_0, system_fn_hash_1, system_fn_hash_2, system_fn_hash_3] = system;

    # b0..b6 are the 7 opcode bits (LSB -> MSB) used by op flag helpers.
    let [
        d0_unused,
        b0,
        b1,
        b2,
        b3,
        b4,
        b5,
        b6,
        d8_unused,
        d9_unused,
        d10_unused,
        d11_unused,
        d12_unused,
        d13_unused,
        d14_unused,
        d15_unused,
        d16_unused,
        d17_unused,
        d18_unused,
        d19_unused,
        d20_unused,
        d21_unused,
        d22_unused,
        d23_unused
    ] = decoder;

    let op_bits = [b0, b1, b2, b3, b4, b5, b6];

    let is_pad = flag_pad(op_bits);
    let is_dup = flag_dup(op_bits);
    let is_dup1 = flag_dup1(op_bits);
    let is_dup2 = flag_dup2(op_bits);
    let is_dup3 = flag_dup3(op_bits);
    let is_dup4 = flag_dup4(op_bits);
    let is_dup5 = flag_dup5(op_bits);
    let is_dup6 = flag_dup6(op_bits);
    let is_dup7 = flag_dup7(op_bits);
    let is_dup9 = flag_dup9(op_bits);
    let is_dup11 = flag_dup11(op_bits);
    let is_dup13 = flag_dup13(op_bits);
    let is_dup15 = flag_dup15(op_bits);

    let is_clk = flag_clk(op_bits);
    let is_assert = flag_assert(op_bits);
    let is_caller = flag_caller(op_bits);
    let is_sdepth = flag_sdepth(op_bits);
    let is_u32and = flag_u32and(op_bits);
    let is_u32xor = flag_u32xor(op_bits);
    let is_mload = flag_mload(op_bits);
    let is_mstore = flag_mstore(op_bits);
    let is_mloadw = flag_mloadw(op_bits);
    let is_mstorew = flag_mstorew(op_bits);

    let is_swap = flag_swap(op_bits);
    let is_movup2 = flag_movup2(op_bits);
    let is_movup3 = flag_movup3(op_bits);
    let is_movup4 = flag_movup4(op_bits);
    let is_movup5 = flag_movup5(op_bits);
    let is_movup6 = flag_movup6(op_bits);
    let is_movup7 = flag_movup7(op_bits);
    let is_movup8 = flag_movup8(op_bits);

    let is_movdn2 = flag_movdn2(op_bits);
    let is_movdn3 = flag_movdn3(op_bits);
    let is_movdn4 = flag_movdn4(op_bits);
    let is_movdn5 = flag_movdn5(op_bits);
    let is_movdn6 = flag_movdn6(op_bits);
    let is_movdn7 = flag_movdn7(op_bits);
    let is_movdn8 = flag_movdn8(op_bits);

    let is_swapw = flag_swapw(op_bits);
    let is_swapw2 = flag_swapw2(op_bits);
    let is_swapw3 = flag_swapw3(op_bits);
    let is_swapdw = flag_swapdw(op_bits);

    let is_cswap = flag_cswap(op_bits);
    let is_cswapw = flag_cswapw(op_bits);

    # ------------------------------------------------------------------------------------------
    # PAD/DUP/CLK
    # ------------------------------------------------------------------------------------------
    enf s0' = 0 when is_pad;

    let dup_constraints = [
        is_dup * (s0' - s0),
        is_dup1 * (s0' - s1),
        is_dup2 * (s0' - s2),
        is_dup3 * (s0' - s3),
        is_dup4 * (s0' - s4),
        is_dup5 * (s0' - s5),
        is_dup6 * (s0' - s6),
        is_dup7 * (s0' - s7),
        is_dup9 * (s0' - s9),
        is_dup11 * (s0' - s11),
        is_dup13 * (s0' - s13),
        is_dup15 * (s0' - s15)
    ];
    enf c = 0 for c in dup_constraints;

    enf s0' = system_clk when is_clk;

    # ------------------------------------------------------------------------------------------
    # SWAP/MOV
    # ------------------------------------------------------------------------------------------
    let swap_eqs = [
        s0' - s1,
        s1' - s0
    ];
    enf c = 0 for c in swap_eqs when is_swap;

    let movup_constraints = [
        is_movup2 * (s0' - s2),
        is_movup3 * (s0' - s3),
        is_movup4 * (s0' - s4),
        is_movup5 * (s0' - s5),
        is_movup6 * (s0' - s6),
        is_movup7 * (s0' - s7),
        is_movup8 * (s0' - s8)
    ];
    enf c = 0 for c in movup_constraints;

    let movdn_constraints = [
        is_movdn2 * (s2' - s0),
        is_movdn3 * (s3' - s0),
        is_movdn4 * (s4' - s0),
        is_movdn5 * (s5' - s0),
        is_movdn6 * (s6' - s0),
        is_movdn7 * (s7' - s0),
        is_movdn8 * (s8' - s0)
    ];
    enf c = 0 for c in movdn_constraints;

    # ------------------------------------------------------------------------------------------
    # SWAPW/SWAPDW
    # ------------------------------------------------------------------------------------------
    let swapw_eqs = [
        s0' - s4,
        s1' - s5,
        s2' - s6,
        s3' - s7,
        s4' - s0,
        s5' - s1,
        s6' - s2,
        s7' - s3
    ];
    enf c = 0 for c in swapw_eqs when is_swapw;

    let swapw2_eqs = [
        s0' - s8,
        s1' - s9,
        s2' - s10,
        s3' - s11,
        s8' - s0,
        s9' - s1,
        s10' - s2,
        s11' - s3
    ];
    enf c = 0 for c in swapw2_eqs when is_swapw2;

    let swapw3_eqs = [
        s0' - s12,
        s1' - s13,
        s2' - s14,
        s3' - s15,
        s12' - s0,
        s13' - s1,
        s14' - s2,
        s15' - s3
    ];
    enf c = 0 for c in swapw3_eqs when is_swapw3;

    let swapdw_eqs = [
        s0' - s8,
        s1' - s9,
        s2' - s10,
        s3' - s11,
        s4' - s12,
        s5' - s13,
        s6' - s14,
        s7' - s15,
        s8' - s0,
        s9' - s1,
        s10' - s2,
        s11' - s3,
        s12' - s4,
        s13' - s5,
        s14' - s6,
        s15' - s7
    ];
    enf c = 0 for c in swapdw_eqs when is_swapdw;

    # ------------------------------------------------------------------------------------------
    # CSWAP/CSWAPW
    # ------------------------------------------------------------------------------------------
    let cswap_c = s0;

    # Binary constraint for the cswap selector.
    enf cswap_c^2 = cswap_c when is_cswap;

    let cswap_eqs = [
        s0' - select(cswap_c, s2, s1),
        s1' - select(cswap_c, s1, s2)
    ];
    enf c = 0 for c in cswap_eqs when is_cswap;

    # Binary constraint for the cswapw selector.
    enf cswap_c^2 = cswap_c when is_cswapw;

    let cswapw_eqs = [
        s0' - select(cswap_c, s5, s1),
        s1' - select(cswap_c, s6, s2),
        s2' - select(cswap_c, s7, s3),
        s3' - select(cswap_c, s8, s4),
        s4' - select(cswap_c, s1, s5),
        s5' - select(cswap_c, s2, s6),
        s6' - select(cswap_c, s3, s7),
        s7' - select(cswap_c, s4, s8)
    ];
    enf c = 0 for c in cswapw_eqs when is_cswapw;

    # ------------------------------------------------------------------------------------------
    # CHIPLETS BUS REQUESTS (U32 BITWISE)
    # ------------------------------------------------------------------------------------------
    # U32AND/U32XOR requests use the (a, b, z) tuple from the stack.
    bus_6_chiplets_bus.remove(BITWISEAND, s0, s1, s0') when is_u32and;
    bus_6_chiplets_bus.remove(BITWISEXOR, s0, s1, s0') when is_u32xor;

    # ------------------------------------------------------------------------------------------
    # CHIPLETS BUS REQUESTS (MEMORY OPS)
    # ------------------------------------------------------------------------------------------
    # Memory requests use label + ctx + addr + clk + payload.
    bus_6_chiplets_bus.remove(MEMREADELEMENT, system_ctx, s0, system_clk, s0') when is_mload;
    bus_6_chiplets_bus.remove(MEMWRITEELEMENT, system_ctx, s0, system_clk, s1) when is_mstore;
    bus_6_chiplets_bus.remove(
        MEMREADWORD,
        system_ctx,
        s0,
        system_clk,
        s0', s1', s2', s3'
    ) when is_mloadw;
    bus_6_chiplets_bus.remove(
        MEMWRITEWORD,
        system_ctx,
        s0,
        system_clk,
        s1, s2, s3, s4
    ) when is_mstorew;

    # ------------------------------------------------------------------------------------------
    # ASSERT/CALLER/SDEPTH
    # ------------------------------------------------------------------------------------------

    enf s0 = 1 when is_assert;

    # CALLER: load the current fn_hash onto the top 4 stack elements.
    let caller_eqs = [
        s0' - system_fn_hash_0,
        s1' - system_fn_hash_1,
        s2' - system_fn_hash_2,
        s3' - system_fn_hash_3
    ];
    enf c = 0 for c in caller_eqs when is_caller;

    # SDEPTH: push current stack depth to the top.
    enf s0' = stack_b0 when is_sdepth;
}
