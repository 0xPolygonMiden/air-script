def IntegrityConstraintsExample_Variables

trace_columns {
    main: [a, b],
}

public_inputs {
    stack_inputs: [16],
}

periodic_columns {
    k: [1, 1, 1, 0]
}

boundary_constraints {
    enf a.first = stack_inputs[0];
    enf b.first = 0;
}

integrity_constraints {
    let x = a + 2
    let y = b + 5
    enf b' = k * x * y
}